{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/reset-credits",
      "schedule": "0 0 1 * *"
    }
  ],
  "regions": ["iad1"],
  "env": {
    "NEXT_PUBLIC_SITE_URL": "@next_public_site_url"
  }
}
